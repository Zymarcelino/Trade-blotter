# Dependencies — reinstalled from the lockfile inside the builder stage
node_modules

# Build output — regenerated by `npm run build`
dist
dist-ssr

# Test / coverage artifacts
coverage

# Version control
.git
.gitignore

# Logs
logs
*.log
npm-debug.log*

# Local env overrides — must NOT leak into the production image.
# Vite only reads .env.development in dev mode, but excluding it keeps the
# build context same-origin and lean.
.env
.env.*
!.env.production

# Editor / OS files
.vscode
.idea
.DS_Store
*.local

# Docker files themselves
Dockerfile
.dockerignore
