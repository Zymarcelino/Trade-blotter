# LOCAL Vite dev overrides ONLY.
# Used when running `npm run dev` (frontend on :5173) against the backend on :3000,
# where the two origins differ.
#
# For Docker and hosted deployments these variables are left UNSET so the
# same-origin defaults in src/config/env.ts (`/api/v1` and a host-derived
# ws(s)://.../ws) apply. Do NOT bake localhost URLs into production builds.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000/ws
